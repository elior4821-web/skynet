{{ 'arelio.css' | asset_url | stylesheet_tag }}

<div class="arelio arelio-section arelio-faq">
  <div class="arelio-container center">
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="section-sub">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <div class="arelio-container faq-list">
    {% for block in section.blocks %}
      <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="faq-answer">{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>

  {% if section.settings.show_cta %}
    <div class="arelio-container" style="margin-top:48px;">
      <div class="banner">
        <div>
          {% if section.settings.cta_heading != blank %}
            <h2 class="section-title">{{ section.settings.cta_heading }}</h2>
          {% endif %}
          {% if section.settings.cta_text != blank %}
            <p class="section-sub left">{{ section.settings.cta_text }}</p>
          {% endif %}
          {% if section.settings.cta_button_label != blank %}
            <a class="btn btn-primary" href="{{ section.settings.cta_button_link | default: '#' }}">
              {{ section.settings.cta_button_label }}
            </a>
          {% endif %}
        </div>
        <div class="product-photo" style="min-height:250px;">
          <div class="mini-product" style="transform:scale(0.72);">
            <div class="pillow-layer p1"></div>
            <div class="pillow-layer p2"></div>
            <div class="pillow-layer p3"></div>
            <div class="neck-hole"></div>
            <div class="front-shine"></div>
            <div class="tube"></div>
            <div class="pump"></div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Arelio FAQ",
  "tag": "section",
  "class": "arelio-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to know"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Quick answers about Arelio, usage, shipping and returns.</p>"
    },
    {
      "type": "header",
      "content": "Contact banner"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show contact banner",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Banner heading",
      "default": "Still have a question?"
    },
    {
      "type": "richtext",
      "id": "cta_text",
      "label": "Banner text",
      "default": "<p>Contact us and we will help you choose the right Arelio setup.</p>"
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "Banner button label",
      "default": "Contact Us 💬"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "Banner button link",
      "info": "Link to your contact page (e.g. /pages/contact)."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is Arelio?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Arelio is an inflatable neck support pillow designed to help you stay comfortable during long sitting sessions such as gaming, working, studying and traveling.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Arelio FAQ",
      "blocks": [
        { "type": "faq", "settings": { "open": true, "question": "What is Arelio?", "answer": "<p>Arelio is an inflatable neck support pillow designed to help you stay comfortable during long sitting sessions such as gaming, working, studying and traveling.</p>" } },
        { "type": "faq", "settings": { "question": "Who is this product for?", "answer": "<p>It is made for gamers, desk workers, students, creators, travelers and anyone who sits for long periods and wants adjustable neck support.</p>" } },
        { "type": "faq", "settings": { "question": "How do I use it?", "answer": "<p>Place the pillow around your neck, use the hand pump to inflate it, then adjust the air level until it feels comfortable for you.</p>" } },
        { "type": "faq", "settings": { "question": "Can I adjust the support level?", "answer": "<p>Yes. The inflatable design lets you add or release air to control the firmness and support level.</p>" } },
        { "type": "faq", "settings": { "question": "Is it good for gaming and desk work?", "answer": "<p>Yes. Arelio is designed especially for long sitting sessions, including gaming, computer work, studying and streaming.</p>" } },
        { "type": "faq", "settings": { "question": "Is this a medical device?", "answer": "<p>No. Arelio is a comfort product. It is not a medical device and does not replace professional medical advice or treatment.</p>" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>Estimated delivery is usually 7 to 14 business days, depending on your location and shipping conditions.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer returns?", "answer": "<p>Yes. We offer a 30 day return policy. Update this to match your store's real policy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
