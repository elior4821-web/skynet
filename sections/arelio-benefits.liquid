{{ 'arelio.css' | asset_url | stylesheet_tag }}

<div class="arelio arelio-section arelio-benefits{% if section.settings.overlap %} lift{% endif %}">
  <div class="arelio-container">
    {% if section.settings.heading != blank %}
      <div class="center">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}
          <p class="section-sub">{{ section.settings.subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="features-strip">
      {% for block in section.blocks %}
        <div class="mini-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="icon">{{ block.settings.icon }}</div>
          {% endif %}
          <div>
            <b>{{ block.settings.title }}</b>
            <span>{{ block.settings.text }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Arelio Benefits",
  "tag": "section",
  "class": "arelio-section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "overlap",
      "label": "Overlap previous section",
      "info": "Pulls the cards up so they sit over the hero (like the original layout).",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "💨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Air Adjustable"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Inflate or deflate until it feels right."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Arelio Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "💨", "title": "Air Adjustable", "text": "Inflate or deflate until it feels right." } },
        { "type": "benefit", "settings": { "icon": "🪶", "title": "Soft and Light", "text": "Comfortable for everyday use." } },
        { "type": "benefit", "settings": { "icon": "⏱", "title": "Long Sessions", "text": "Made for gaming, work and study." } },
        { "type": "benefit", "settings": { "icon": "🎒", "title": "Easy to Carry", "text": "Compact enough for travel." } }
      ]
    }
  ]
}
{% endschema %}
